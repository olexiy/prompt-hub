{
  "name": "prompt-hub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "pnpm --filter @prompt-hub/web build && pnpm --filter @prompt-hub/api dev",
    "dev:web": "pnpm --filter @prompt-hub/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "e2e": "pnpm --filter @prompt-hub/e2e e2e",
    "visual": "pnpm --filter @prompt-hub/e2e visual",
    "visual:update": "pnpm --filter @prompt-hub/e2e visual:update",
    "perf": "pnpm --filter @prompt-hub/e2e perf",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migrate": "pnpm --filter @prompt-hub/db migrate",
    "db:generate": "pnpm --filter @prompt-hub/db generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "pnpm": "12.14.0",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
