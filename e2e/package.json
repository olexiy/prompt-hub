{
  "name": "@prompt-hub/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Playwright end-to-end specs against the local Worker.",
  "scripts": {
    "e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json",
    "visual": "playwright test -c playwright.visual.config.ts",
    "visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots",
    "perf": "node perf/perf.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "postgres": "^3.4.9"
  }
}
