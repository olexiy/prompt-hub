{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "prompt-hub",
  "main": "src/index.ts",
  // Matches the bundled workerd runtime; bump together with wrangler.
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // The built web app; /api/* goes to the Worker first, everything else is a static file or the SPA.
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Placeholder until the real Hyperdrive config exists (#21); local dev and tests use
      // localConnectionString (local Supabase), CI overrides it with
      // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:54322/postgres",
    },
  ],
  // Rate limits per client IP (src/security/rate-limit.ts). namespace_id is any number unique
  // in the Cloudflare account; period must be 10 or 60 seconds.
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "WRITE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
  ],
  "observability": { "enabled": true },
  // No anonymous usage telemetry from wrangler.
  "send_metrics": false,
}
